<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    
<form method="post" action="/listing">
    <input name="listing[title]" type="text" placeholder="Title">
    <br> 
    <input name="listing[description]" type="text" placeholder="Enter description">
    <br>
    <input name="listing[image]" type="text" placeholder="Image">
    <br>
    <input name="listing[price]" type="number" placeholder="Enter price">
    <br>
    <input name="listing[country]" type="text" placeholder="Enter country">
    <br>
    <input name="listing[location]" type="text" placeholder="Location">
    <br><br>
    <button type="submit">Submit</button>
</form>
</body>
</html>