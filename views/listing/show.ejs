<% layout('/layouts/boilerplate') -%>

<div class="row">
    <div class="col-8 offset-3 ">
        <h2>Listing Details</h2>
    </div><br>

    <div class="col-6 offset-3">
        <img src="<%=data.image.url%>" class="card-img-top show-img" alt="...">
        <div class="card-body">
            <p class="card-text mb-2"><b><%= data.owner.username %></b></p>
            <p class="card-text mb-2"><%= data.description %></p>
            <p class="card-text mb-2">&#8377;<%= data.price.toLocaleString("en-IN") %></p>
            <p class="card-text mb-2"><%= data.location %></p>
            <p class="card-text mb-2"><%= data.country %></p>
        </div>
    </div>
</div>

<% if(currUser && data.owner._id.equals(currUser._id)) { %>
    <div class="col-8 offset-3"> 
        <div class="btns">
            <a href="http://localhost:8080/listing/<%=data._id%>/edit" class="btn btn-dark redButton">edit</a>
            <button class="btn btn-dark">Delete</button>
        </div>
        <hr>
    </div>
<% } %>



<div class="col-8 offset-3">
    <h4>Leave a Review</h4>
    <% if(currUser) { %>
        <form action="/listing/<%=data._id%>/review" method="POST" class="needs-validation" novalidate>
            <div class="mb-3 mt-3">
                <label for="rating">Rating</label>
                <fieldset class="starability-slot">
                    <legend>First rating:</legend>
                    <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                    <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                    <label for="first-rate1" title="Terrible">1 star</label>
                    <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                    <label for="first-rate2" title="Not good">2 stars</label>
                    <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                    <label for="first-rate3" title="Average">3 stars</label>
                    <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                    <label for="first-rate4" title="Very good">4 stars</label>
                    <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                    <label for="first-rate5" title="Amazing">5 stars</label>
                </fieldset>
            </div>
            <div>
                <label for="comment">Comments</label>
                <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control" required></textarea>
                <div class="invalid-feedback">please add some comment for review</div>
            </div>
            <br>
            <button class="btn btn-outline-dark">Submit</button>
        </form>
    <% } %>


   <%if(data.review > 0){%>
    <div class="row">
         <p><b>All Review</b></p>
        <% for(review of data.reviews) { %>
            <div class="card col-5 ms-3 mb-4">
                <div class="card-body">
                    <h5 class="card-title"><%= review.author.username %></h5>
                    <p class="starability-result" data-rating="<%= review.rating %>">Rated: 3 stars</p>
                    <p class="card-text"><%= review.comment %></p>
                </div>
                <form action="/listing/<%=data._id%>/review/<%=review._id%>?_method=DELETE" method="POST">
                    <button class="btn btn-sm btn-dark mb-3">delete</button>
                </form>
            </div>
        <% } %>
    </div> 
    <%}%>
    <hr>
</div>  



<div class="col-8 offset-3 mb-3">
    <h3>Where you'll be</h3>
    <div id="map" style="height: 400px; width: 100%; z-index: 0;"></div>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
    const listing = {
        title: "<%= data.title %>",
        location: "<%= data.location %>",
        geometry: <%- JSON.stringify(data.geometry) %>
    };
</script>
<script src="/js/map.js"></script>